# ai vault secrets — copy to vault.yml and encrypt.
#
#   cp vault.yml.example vault.yml
#   # fill in the values (see "Populating the vault" in hosts/ai/README.md)
#   ansible-vault encrypt vault.yml
#
# vault.yml is gitignored in plaintext; only the encrypted form is committed.
# (This .example file is a safe plaintext template with placeholders.)

---
# Firstboot passwords. Console-only after SSH hardening (no SSH password auth).
vault_root_pw: CHANGE_ME_strong_root_password
vault_pi_pw: CHANGE_ME_strong_pi_password

# --- LiteLLM app secrets ---
# Populate from their sources:
#   vault_nebius_api_key      — the Nebius API key (Nebius console)
#   vault_litellm_master_key  — a master key you choose (auths proxy clients)
#   vault_postgres_password   — a postgres password you choose
#   vault_tls_crt / vault_tls_key — the cert+key pair (see hosts/ai/README.md
#                                §TLS certificate). mkcert for litellm.home.arpa.
#
# When adopting a host already set up by hand, these can instead be read off it:
#   ssh ai.home.arpa 'cat /opt/litellm/.env'           # 3 KEY=VALUE lines
#   ssh ai.home.arpa 'cat /opt/litellm/certs/tls.crt'  # PEM cert, multi-line
#   ssh ai.home.arpa 'cat /opt/litellm/certs/tls.key'  # PEM key, multi-line

vault_nebius_api_key: CHANGE_ME_nebius_api_key
vault_litellm_master_key: CHANGE_ME_sk_master_key
vault_postgres_password: CHANGE_ME_postgres_password

# TLS cert + key, kept as a pair. The cert isn't a secret but lives in the
# vault with the key so they can't drift apart and rotate together. Indent
# continuation lines by 2 spaces in the YAML (folded scalar). Example:
#   vault_tls_crt: |
#     -----BEGIN CERTIFICATE-----
#     ...
#     -----END CERTIFICATE-----
vault_tls_crt: |
  CHANGE_ME_paste_the_tls_cert_pem_here
vault_tls_key: |
  CHANGE_ME_paste_the_tls_key_pem_here
