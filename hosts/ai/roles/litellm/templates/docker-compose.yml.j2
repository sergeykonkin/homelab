# Managed by homelab hosts/ai/roles/litellm — do not edit on the host.
# Templated from docker-compose.yml.j2. The role also writes, from the host
# vault: .env (3 app vars) and certs/tls.{crt,key} in the deploy dir.
#
# No shared docker network yet. When open-webui is added, give both apps a
# shared external network then.
services:
  litellm:
    image: docker.litellm.ai/berriai/litellm:main-stable
    container_name: litellm
    restart: unless-stopped
    volumes:
      - config:/app/config:ro
      - /opt/litellm/certs:/app/certs:ro
    command:
      - "--config=/app/config/config.yaml"
      - "--ssl_certfile_path=/app/certs/tls.crt"
      - "--ssl_keyfile_path=/app/certs/tls.key"
    ports:
      - "443:4000"
    environment:
      DATABASE_URL: "postgresql://llmproxy:${POSTGRES_PASSWORD}@db:5432/litellm"
      STORE_MODEL_IN_DB: "True"
      NEBIUS_API_KEY: "${NEBIUS_API_KEY}"
      LITELLM_MASTER_KEY: "${LITELLM_MASTER_KEY}"
    depends_on:
      db:
        condition: service_healthy
      models-updater:
        condition: service_healthy
    healthcheck:
      test:
        - CMD-SHELL
        - python3 -c "import urllib.request,ssl; ctx=ssl.create_default_context(); ctx.check_hostname=False; ctx.verify_mode=ssl.CERT_NONE; urllib.request.urlopen('https://localhost:4000/health/liveliness',context=ctx)"
      interval: 30s
      timeout: 10s
      retries: 3
      # A cold start runs ~157 prisma migrations against a fresh DB before the
      # proxy binds :4000 — that took ~4 min in practice. Give the grace period
      # enough headroom so the container isn't marked unhealthy during a cold
      # start (after this, 3 retries × 30 s flags a truly broken app at ~5 m).
      start_period: 300s

  models-updater:
    build:
      context: .
      dockerfile: Dockerfile.models-updater
    container_name: litellm-models-updater
    restart: unless-stopped
    environment:
      NEBIUS_API_KEY: "${NEBIUS_API_KEY}"
      CONFIG_DIR: "/app/config"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - config:/app/config
    healthcheck:
      test: ["CMD-SHELL", "test -f /app/config/config.yaml"]
      interval: 2s
      timeout: 1s
      retries: 30

  db:
    image: postgres:16
    container_name: litellm_db
    restart: always
    environment:
      POSTGRES_DB: litellm
      POSTGRES_USER: llmproxy
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d litellm -U llmproxy"]
      interval: 1s
      timeout: 5s
      retries: 10

volumes:
  postgres_data:
    name: litellm_postgres_data
  config:
    name: litellm_config
