# Nebius Token Factory API key used for catalog synchronization and inference.
NEBIUS_API_KEY=CHANGE_ME

# LiteLLM master key for client and model-management authentication.
LITELLM_MASTER_KEY=CHANGE_ME

# Password for LiteLLM's PostgreSQL database user.
POSTGRES_PASSWORD=CHANGE_ME

# Seconds between completed model synchronization cycles.
SYNC_INTERVAL=600
