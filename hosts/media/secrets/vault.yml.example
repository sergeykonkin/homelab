# media vault schema — placeholders only.
# From hosts/media, use: ansible-vault edit secrets/vault.yml
# If the vault is missing, use: ansible-vault create secrets/vault.yml
# Paste this schema into the editor and fill in strong passwords.
# Saving encrypts the file. Verify the $ANSIBLE_VAULT; header before staging.
---
# Console passwords; SSH uses public-key authentication after firstboot.
vault_root_pw: CHANGE_ME_strong_root_password
vault_pi_pw: CHANGE_ME_strong_pi_password
