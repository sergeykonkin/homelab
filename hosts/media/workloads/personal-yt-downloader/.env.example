# Single-user login password for the downloader.
PASSWORD=CHANGE_ME_strong_single_user_password

# Optional bearer token for direct /api/jobs* requests (curl, iOS Shortcuts).
# Leave blank to disable bearer auth. Carries full API power: use a long random string.
API_TOKEN=

# Cloudflare named-tunnel token.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_cloudflared_tunnel_token
