# acme Ansible secrets schema — use placeholders only in this example.
#
# Edit the gitignored secrets.yml, then encrypt it to the tracked secrets.yml.age
# with age --armor and the repository recipient.

---
# Bootstrap passwords. Console-only after SSH hardening (no SSH password auth).
bootstrap_root_password: CHANGE_ME_strong_root_password
bootstrap_pi_password: CHANGE_ME_strong_pi_password
