# acme vault schema — use placeholders only in this example.
#
# From hosts/acme/ (so ansible.cfg supplies the vault password file):
#   ansible-vault edit secrets/vault.yml
# If no vault exists, use `ansible-vault create secrets/vault.yml`, paste this
# schema into the editor, and fill in the values. Saving encrypts the file.
#
# vault.yml is tracked, NOT gitignored in plaintext. Verify its
# $ANSIBLE_VAULT; header before staging; never overwrite it with this example.
# (This .example file is a safe plaintext template with placeholders.)

---
# Bootstrap passwords. Console-only after SSH hardening (no SSH password auth).
vault_root_pw: CHANGE_ME_strong_root_password
vault_pi_pw: CHANGE_ME_strong_pi_password
