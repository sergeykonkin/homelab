# tailgate vault schema — use placeholders only in this example.
#
# From hosts/tailgate/ (so ansible.cfg supplies the vault password file):
#   ansible-vault edit secrets/vault.yml
# If no vault exists, use `ansible-vault create secrets/vault.yml`, paste this
# schema into the editor, and fill in the values. Saving encrypts the file.
#
# vault.yml is tracked, NOT gitignored in plaintext. Verify its
# $ANSIBLE_VAULT; header before staging; never overwrite it with this example.
# (This .example file is a safe plaintext template with placeholders.)

---
# New root password (set by bootstrap). Choose a strong value; store it in your
# password manager too — after SSH hardening it's only usable from the console.
vault_root_pw: CHANGE_ME_strong_root_password

# New pi password (set by bootstrap). After SSH hardening, pi can't SSH in
# (no key for pi); this password is for console/serial access only.
vault_pi_pw: CHANGE_ME_strong_pi_password

# Tailscale reusable auth key. Mint one at:
#   https://login.tailscale.com/settings/keys
# Use a reusable (or long-lived) key so the node can rejoin the tailnet
# unattended on reprovision. Keep it scoped; revoke when rotating.
vault_tailscale_authkey: tskey-auth-CHANGE_ME
