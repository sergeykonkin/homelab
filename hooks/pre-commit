#!/usr/bin/env python3
"""Require encrypted secret files in the Git index."""

import subprocess
import sys


AGE_HEADER = b"-----BEGIN AGE ENCRYPTED FILE-----"
VAULT_HEADER = b"$ANSIBLE_VAULT;"


def git(*args):
    return subprocess.check_output(["git", *args], stderr=subprocess.PIPE)


def is_host_secret(path):
    parts = path.split("/")
    return len(parts) >= 4 and parts[0] == "hosts" and parts[2] == "secrets"


def is_workload_file(path, filename):
    parts = path.split("/")
    return len(parts) == 3 and parts[0] == "workloads" and parts[2] == filename


def is_workload_secret(path):
    parts = path.split("/")
    return len(parts) == 4 and parts[0] == "workloads" and parts[2] == "secrets"


def main():
    paths = git("ls-files", "--cached", "-z")
    rejected_plaintext = []
    rejected_vault = []
    rejected_age = []

    for raw_path in paths.split(b"\0"):
        if not raw_path:
            continue
        path = raw_path.decode("utf-8", errors="surrogateescape")
        if (
            path == ".vault-pass"
            or is_workload_file(path, ".env")
            or (is_workload_secret(path) and not path.endswith((".age", ".example")))
        ):
            rejected_plaintext.append(path)
        elif is_host_secret(path) and not path.endswith(".example"):
            if not git("show", f":{path}").startswith(VAULT_HEADER):
                rejected_vault.append(path)
        elif (
            path == ".vault-pass.age"
            or is_workload_file(path, ".env.age")
            or (is_workload_secret(path) and path.endswith(".age"))
        ):
            if not git("show", f":{path}").startswith(AGE_HEADER):
                rejected_age.append(path)

    if rejected_plaintext:
        print("Commit blocked: staged plaintext secret files are not allowed:", file=sys.stderr)
        for path in rejected_plaintext:
            print(f"  {path!r}", file=sys.stderr)

    if rejected_vault:
        print("Commit blocked: staged host secrets must be Ansible Vault encrypted:", file=sys.stderr)
        for path in rejected_vault:
            print(f"  {path!r}", file=sys.stderr)

    if rejected_age:
        print("Commit blocked: staged workload secrets must be ASCII-armored age files:", file=sys.stderr)
        for path in rejected_age:
            print(f"  {path!r}", file=sys.stderr)

    if rejected_plaintext or rejected_vault or rejected_age:
        print(
            "Use Ansible Vault for hosts/*/secrets/, age --armor for .vault-pass.age "
            "and workload .age files, and keep plaintext files out of Git.",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.CalledProcessError:
        print("Commit blocked: unable to inspect staged secrets.", file=sys.stderr)
        sys.exit(1)
