{
  "zone_id": "CHANGE_ME_32_character_cloudflare_zone_id",
  "zone_name": "example.com",
  "validation_zone": "acme.example.com",
  "cloudflare_api_token": "CHANGE_ME_cloudflare_api_token",
  "cloudflare_timeout_seconds": 10,
  "auth_failures_per_minute": 5,
  "updates_per_minute": 10,
  "clients": [
    {
      "hostname": "acme.example.com",
      "username": "CHANGE_ME_unique_username",
      "password": "CHANGE_ME_strong_password_at_least_32_characters",
      "subdomain": "CHANGE_ME_unique_validation_subdomain"
    }
  ]
}
