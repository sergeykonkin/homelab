# Local vault password file — never commit it.
# Store the password separately in your password manager.
.vault-pass
hosts/*/workloads/*/.env
hosts/*/workloads/*/secrets/*
!hosts/*/workloads/*/secrets/*.age
!hosts/*/workloads/*/secrets/*.example

# Python
__pycache__/
*.py[cod]

# OS
.DS_Store

# Ansible runtime metadata
.ansible/

# Temp files
tmp/

# NOTE: hosts/<name>/ansible/secrets/vault.yml IS committed — but ONLY in its
# ansible-vault-encrypted form (file starts with `$ANSIBLE_VAULT;...`).
# Plaintext vault.yml is NOT ignored. Before staging, verify the vault header.
# If encryption is needed, run from hosts/<name>/ansible/ to load its ansible.cfg:
#     ansible-vault encrypt secrets/vault.yml
# A plaintext vault.yml committed by accident would leak every secret.
# The committed hosts/<name>/ansible/secrets/vault.yml.example files are
# templates with placeholder values and are safe.
